# Copy this file to .env and fill in your own values. Never commit the real .env.

TIKTOK_USERNAME=
TIKTOK_PASSWORD=

# Browser
TIKTOK_HEADLESS=false
TIKTOK_BROWSER_BINARY=
TIKTOK_USER_DATA_DIR=

# Timing (seconds)
TIKTOK_ELEMENT_WAIT_TIMEOUT=10
TIKTOK_MIN_DELAY=1.0
TIKTOK_MAX_DELAY=3.0
TIKTOK_SCROLL_PAUSE=2.0
TIKTOK_ACTION_COOLDOWN=4.0

# Safety limits — keep these conservative to avoid account flags
TIKTOK_MAX_LIKES=30
TIKTOK_MAX_FOLLOWS=10
TIKTOK_MAX_COMMENTS=5
